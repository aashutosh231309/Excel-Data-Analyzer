{
  "name": "excel-data-analyzer",
  "productName": "Excel Data Analyzer",
  "version": "0.2.0",
  "private": true,
  "description": "Offline Windows desktop application to import, filter and analyze Excel payment records.",
  "author": {
    "name": "Excel Data Analyzer"
  },
  "license": "UNLICENSED",
  "main": "dist-electron/main.js",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:renderer": "vite",
    "typecheck": "tsc --noEmit",
    "icons": "node scripts/generate-icons.mjs",
    "build": "npm run typecheck && npm run icons && npm run build:electron && npm run build:renderer",
    "build:electron": "node scripts/build-electron.mjs",
    "build:renderer": "vite build",
    "verify": "npm run build && node scripts/verify.mjs",
    "verify:only": "node scripts/verify.mjs",
    "release:check": "node scripts/release-check.mjs",
    "start": "npm run build && electron .",
    "pack": "npm run build && electron-builder --dir",
    "dist:win": "npm run build && electron-builder --win --x64 --publish never",
    "dist:win:portable": "npm run build && electron-builder --win portable --x64 --publish never",
    "dist:linux": "npm run build && electron-builder --linux --x64"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "lucide-react": "^1.48.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^5.2.0",
    "autoprefixer": "^10.6.1",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.1",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "vite": "^7.3.6"
  }
}
