# Dependencies
node_modules/

# Build output. The leading slash keeps these rules at the repository root, so a
# source directory that happens to be named `release` (scripts/release/) is
# tracked normally.
/dist/
/dist-electron/
/release/
*.tsbuildinfo

# Environment / secrets
.env
.env.*
*.local

# Logs and temporary files
*.log
npm-debug.log*
yarn-error.log*
*.tmp
.tmp/

# Editor / OS noise
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# Electron packaging caches
.cache/
